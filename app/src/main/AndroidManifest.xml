<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- อ่านรายการแอปที่ติดตั้งอยู่บนเครื่อง (source of truth = PackageManager) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".MiniApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.AetherPort"
        android:largeHeap="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ══ Stub components ═══════════════════════════════════════════════
             ต้องประกาศจริงใน manifest เพราะ component ของเกสต์ไม่มีใน PMS ของเครื่อง
             android:process ทำให้เกสต์แต่ละตัวได้ process แยก (1 process = 1 เกสต์)
             ห้าม exported — ไม่ให้แอปอื่นยิงเข้ามา
        -->
        <activity
            android:name=".stub.StubActivity$C0"
            android:exported="false"
            android:launchMode="standard"
            android:process=":p0"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:taskAffinity="com.virtualapp.mini.task.p0"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AetherPort.Stub" />

        <activity
            android:name=".stub.StubActivity$C1"
            android:exported="false"
            android:launchMode="standard"
            android:process=":p1"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:taskAffinity="com.virtualapp.mini.task.p1"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AetherPort.Stub" />

    </application>

</manifest>
