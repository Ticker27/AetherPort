        <item name="android:colorPrimary">#1E88E5</item>
        <item name="android:colorPrimaryDark">#0D47A1</item>
        <item name="android:colorAccent">#03A9F4</item>
    </style>

    <!-- theme ของ stub: โปร่งใส ไม่มี titlebar — activity เกสต์จะทับทันที
